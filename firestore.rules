rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && !id.matches('.*[/].*');
    }

    function isMasterAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'russelthegreat1209@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isValidId(userId) && (isOwner(userId) || isMasterAdmin());
      allow delete: if isMasterAdmin();
    }

    // Commodities Collection
    match /live_commodities/{commodityId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(commodityId);
      allow update, delete: if isSignedIn() && (
        resource.data.supplierId == request.auth.uid || isMasterAdmin()
      );
    }

    // Community Posts Collection (Facebook-style feed with reactions & comments)
    match /live_community_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId);
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'reactions', 'comments', 'likesCount', 'likedBy', 'commentsCount']) ||
        isMasterAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.authorId == request.auth.uid || isMasterAdmin()
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(commentId);
        allow update, delete: if isSignedIn() && (
          resource.data.authorId == request.auth.uid || isMasterAdmin()
        );
      }
    }

    // NVAT Bulletins & Past Updates Archive
    match /nvat_bulletins/{bulletinId} {
      allow read: if true;
      allow create, update, delete: if isMasterAdmin();
    }

    // AI History Collection
    match /ai_history/{entryId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isMasterAdmin()
      );
      allow create: if isSignedIn() && isValidId(entryId);
      allow delete: if isMasterAdmin();
    }

    // Moderation Reports Collection
    match /moderation_reports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid || isMasterAdmin()
      );
      allow create: if isSignedIn() && isValidId(reportId);
      allow update, delete: if isMasterAdmin();
    }

    // Orders & Private Chat
    match /live_orders/{orderId} {
      allow read, write: if isSignedIn();
    }

    match /live_chat_threads/{threadId} {
      allow read, write: if isSignedIn();
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
